# ==============================================================================
# HUNAINATH EDUCATIONAL ACADEMY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core Django Settings
SECRET_KEY=change-me-to-a-secure-random-key-in-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1,.ngrok-free.app

# Database Configuration
# Production PostgreSQL example:
# DATABASE_URL=postgresql://db_user:db_password@db_host:5432/hunainath_db
DATABASE_URL=sqlite:///db.sqlite3

# Security & Trusted Origins (Add your domain and ngrok domains)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://*.ngrok-free.app
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# School Details
SCHOOL_NAME=Shree Hunainath Educational Academy
SCHOOL_NAME_NEP=श्री हुनैनाथ एजुकेसनल एकेडेमी
SCHOOL_TAGLINE=Empowering Minds, Inspiring Futures
SCHOOL_PHONE=+977-99-402120
SCHOOL_MOBILE=+977-9848712345
SCHOOL_EMAIL=info@hunainath.edu.np
SCHOOL_ADDRESS=Shuklaphanta Municipality-5, Garjamani, Kanchanpur, Sudurpashchim, Nepal
SCHOOL_ESTABLISHED_YEAR=2008

# Web Push Notification Keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CLAIMS_SUB=mailto:admin@hunainath.edu.np
